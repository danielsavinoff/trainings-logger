    <ImplementationPlan>
      <T-001>
        <Title>Apply shared spacing to help and align records hints</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Apply the existing one-row vertical and two-column horizontal panel padding around the complete help view, accounting for the reduced inner dimensions on resize.</Criterion>
          <Criterion>Align records footer hints to the left edge of the padded content; retain their current wording, colors, and responsive wrapping.</Criterion>
          <Criterion>Add rendering checks for the outer inset and left alignment at wide and compact terminal sizes.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>go test ./internal/infra/tui/views -run 'TestHelpRendering|TestRecordsCompactFooter'</Command>
        </Verification>
      </T-001>
      <T-002>
        <Title>Add identity domain and SQLite credential storage</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Add identity and credential domain types with string IDs and a Dropbox provider enum, plus repository interfaces for identity and credentials.</Criterion>
          <Criterion>Add a reversible SQLite migration for identities and one identity_credentials row per identity, with the requested encrypted token, expiry, and update fields and a cascading identity foreign key.</Criterion>
          <Criterion>Implement SQLite repositories and tests for identity and credential round trips, provider validation, and missing or invalid references.</Criterion>
          <Criterion>Treat token fields as opaque encrypted values; do not add encryption or OAuth behavior.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>go test ./internal/infra/persistence/sqlite</Command>
        </Verification>
      </T-002>
      <T-003>
        <Title>Define preferences and remote-state application contracts</Title>
        <DependsOn></DependsOn>
        <AcceptanceCriteria>
          <Criterion>Add an application operation for saving a selected weight preference through the existing repository and transaction pattern.</Criterion>
          <Criterion>Define application contracts to store and load a complete remote-state snapshot containing exercises, sets, and preferences while excluding identities and credentials.</Criterion>
          <Criterion>Expose those operations through TUI application bindings so screens can use real or test implementations.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>go test ./internal/app/command ./internal/app/ports</Command>
        </Verification>
      </T-003>
      <T-004>
        <Title>Add Preferences and Sync views and route shortcuts</Title>
        <DependsOn>T-001, T-003</DependsOn>
        <AcceptanceCriteria>
          <Criterion>Route p to Preferences and s to Sync outside dialogs/help, while preserving ge/gs and existing row navigation. Restore records state when leaving either view.</Criterion>
          <Criterion>Show g, kg, and lb in Preferences, persist the selected value, and reflect it in records behavior.</Criterion>
          <Criterion>Show remote store and load actions in Sync and call the application contracts when configured; otherwise show unavailable without changing local data.</Criterion>
          <Criterion>Document p and s in help and cover responsive view rendering, actions, errors, return behavior, and unchanged gs routing with tests.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>go test ./internal/infra/tui/views ./internal/infra/tui/starter</Command>
        </Verification>
      </T-004>
      <T-005>
        <Title>Update GRACE projections and verify the integrated change</Title>
        <DependsOn>T-002, T-004</DependsOn>
        <AcceptanceCriteria>
          <Criterion>Update graph and verification indexes and routed documents for the records/help routing, preferences/sync UI, identity domain, remote-state ports, and SQLite identity persistence.</Criterion>
          <Criterion>Run the full test suite and vet with normal validation; review snapshots and migration up/down behavior. Do not use snapshot regeneration during final checks.</Criterion>
        </AcceptanceCriteria>
        <Verification>
          <Command>go test ./...</Command>
          <Command>go vet ./...</Command>
        </Verification>
      </T-005>
    </ImplementationPlan>
